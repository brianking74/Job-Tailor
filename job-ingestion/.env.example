# ==============================================================================
# Job Ingestion Pipeline - Environment Variables Template
# Copy this file to .env.local or set these variables in Vercel/Supabase settings.
# ==============================================================================

# 1. Database Configuration (Supabase PostgreSQL Connection String)
# Recommended to use transaction mode (port 6543) or Prisma/Drizzle connection pool pooling.
DATABASE_URL=postgres://postgres:[YOUR_SUPABASE_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Pipeline Security Credentials
# Random 32-character hex strings ensuring third-parties cannot trigger costly cron tasks manually.
CRON_SECRET=35fca78eef83151b7de6c0b31526673b
DIRECT_INGEST_SECRET=88f9a2de2e92cbb41a0ba808945cf40e

# 3. Third-Party Job API Keys
# Adzuna API Access (Primary crawler) Focuses on globally distributed listings
ADZUNA_APP_ID=adzuna_app_id_placeholder
ADZUNA_APP_KEY=adzuna_entry_key_placeholder
ADZUNA_COUNTRY=gb

# Reed.co.uk API Access (UK specialist crawler)
REED_API_KEY=reed_api_key_placeholder

# 4. Optional LLM Extraction Fallback API (Google AI Studio Key)
# Triggers only when standard regex parsers fail to isolate salary scales in text
GEMINI_API_KEY=AIzaSy...
